DB_HOST=localhost
DB_PORT=3306
DB_NAME=aliprompt
DB_USER=your_database_user
DB_PASSWORD=your_database_password
AUTH_SECRET=generate_a_long_random_secret_at_least_32_characters
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=use_a_strong_password_at_least_12_characters
ADMIN_PHONE=09xxxxxxxxx
# Escape each dollar sign in bcrypt hashes (\$) so Next.js does not expand it.
ADMIN_ACCESS_CODE_HASH=\$2b\$12\$paste_the_rest_of_your_bcrypt_hash_here
PAYMENT_CARD_NUMBER=your_16_digit_card_number
PAYMENT_CARD_HOLDER=account_holder_name
NAVASAN_API_KEY=
# Prices are defined in USD and converted server-side using Navasan's rial rate, then shown in tomans.
CHATGPT_PLUS_USD=
CLAUDE_PRO_USD=
NEXT_PUBLIC_SUPPORT_CONSULTATION_URL=
NEXT_PUBLIC_SUPPORT_TICKET_URL=
